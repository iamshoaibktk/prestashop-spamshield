        <target>Segundos mínimos antes do envio</target>
      </trans-unit>
      <trans-unit id="0fc60f9b827ef7cce7030d949d658291">
        <source>Forms submitted faster than this are treated as bots.</source>
        <target>Os formulários enviados mais depressa são tratados como bots.</target>
      </trans-unit>
      <trans-unit id="bc11f343d1ee85c877f186a8bb8cb9f9">
        <source>Allow submissions if the provider is down</source>
        <target>Permitir envios se o fornecedor estiver indisponível</target>
      </trans-unit>
