        <source>Google reCAPTCHA</source>
        <target>Google reCAPTCHA</target>
      </trans-unit>
      <trans-unit id="1a5ae3750877d350abb3367d88a51e1f">
        <source>Create keys at https://www.google.com/recaptcha/admin. v2 and v3 need different keys.</source>
        <target>Cree las claves en https://www.google.com/recaptcha/admin. v2 y v3 necesitan claves distintas.</target>
      </trans-unit>
      <trans-unit id="9610613a2d407a8cb90fe8dbe890be79">
        <source>v2 site key</source>
        <target>Clave de sitio v2</target>
      </trans-unit>
      <trans-unit id="6af7ddb0c3c78768a9528de3abc09eba">
        <source>v2 secret key</source>
        <target>Clave secreta v2</target>
      </trans-unit>
