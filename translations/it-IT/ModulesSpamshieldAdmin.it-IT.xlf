        <target>Punteggio minimo (chiavi basate sul punteggio)</target>
      </trans-unit>
      <trans-unit id="78b5c433d72aedfe1e9502faab99265c">
        <source>Create a widget at https://dash.cloudflare.com under Turnstile.</source>
        <target>Crea un widget su https://dash.cloudflare.com nella sezione Turnstile.</target>
      </trans-unit>
      <trans-unit id="952bf87c967660b7bbd4e1eb08cefc92">
