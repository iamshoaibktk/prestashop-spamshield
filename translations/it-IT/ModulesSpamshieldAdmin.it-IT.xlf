      <trans-unit id="0d3ff706362e28a67a39696a991a1fa8">
        <source>From 0.0 (bot) to 1.0 (human). 0.5 is a good start.</source>
        <target>Da 0.0 (bot) a 1.0 (umano). 0.5 è un buon punto di partenza.</target>
      </trans-unit>
      <trans-unit id="660dceef85b35a0e8897f0a10d5fc519">
        <source>Google reCAPTCHA Enterprise</source>
        <target>Google reCAPTCHA Enterprise</target>
      </trans-unit>
      <trans-unit id="5119a3b94c1c89b3021ddf6d9c10418e">
        <source>Use a site key from Google Cloud Console and an API key allowed to call the reCAPTCHA Enterprise API.</source>
        <target>Usa una chiave del sito di Google Cloud Console e una chiave API autorizzata a chiamare l'API reCAPTCHA Enterprise.</target>
      </trans-unit>
      <trans-unit id="567211f78e286e00c938772c5a27a6c4">
        <source>Google Cloud project ID</source>
        <target>ID del progetto Google Cloud</target>
      </trans-unit>
      <trans-unit id="656a6828d7ef1bb791e42087c4b5ee6e">
