        <target>Форма подписки на рассылку</target>
      </trans-unit>
      <trans-unit id="c7cc3987297f5230512087dbe20b8939">
        <source>Out of stock alert form</source>
        <target>Форма уведомления о поступлении</target>
      </trans-unit>
      <trans-unit id="d148d95f3b8a9643a2961dc88c971f47">
